# Balance-sim run artifacts (CSVs). The written analysis is committed separately.
sim_reports/
# Decoded binary assets: the .b64 sidecars are tracked; the decoded .glb
# working copies are not (decode via python assets/decode_assets.py).
*.glb
# Decoded textures: same deal, .png.b64 sidecars are tracked instead.
assets/world/textures/*.png
# Local build tree.
build/
# Dark wilds generated terrain: the .b64 sidecars are tracked; the decoded
# working copies are not (decode via python assets/decode_assets.py).
assets/world/terrain/dark_wilds_ground.obj
assets/world/terrain/dark_wilds_height.png
# Creature textures: same deal as world textures — .png.b64 sidecars tracked.
assets/creatures/Textures/*.png

# Unreal generated outputs; keep Source, Config, tools and authored Content.
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
**/.vs/
**/__pycache__/
**/lib/Win64/
**/lib/Linux/
*.sln
*.suo
*.VC.db
*.pdb
*.obj
*.log
*.backup
/build-msvc/
/build-masvc/
/Source_Backup_*/
/unreal 5.8 5.8*/
/unreal 5.8/*.zip
/unreal 5.8/Content/CharacterAnimations/
/unreal 5.8/Content/CharacterDefinitions/
/unreal 5.8/Content/Developers/
/unreal 5.8/Content/Collections/
/unreal 5.8/Config/DefaultEditorPerProjectUserSettings.ini
# Retired local project is preserved on disk but excluded from future additions.
/unreal/
