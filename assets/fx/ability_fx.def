# Destruction preset: not an ability effect kind — fired through
# fxForEvent() when buildings, districts, and cities fall. City
# destruction is the game's core fantasy, so it gets the heaviest
# single burst in the catalog: billowing dust that catches an ember
# tint as it rises, still inside the low-spec budget (count <= 256,
# non-additive, one-shot).
[raze]
display_name = Building Collapse
emitter = sphere
count = 192
lifetime = 0.8,3.2
speed = 4,16
spread = 120
size = 1.0,4.0
colors = 2a2624,a04010
additive = false
gravity = -3.0
texture = smoke
duration = 2.5
loop = false

