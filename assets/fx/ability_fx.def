# ---- Rock-kit presets (wave 43) ----
# Event-driven, not kinds: Cthulhu's Domination rock publishes
# AbilityCast events (slot 3) whose tags fxForEvent() maps here —
# "Sunder the Earth" -> rock_rip, "Hurl the Mountain" -> rock_hurl,
# and any rock break prose ("the rock shatters", "the rock crumbles
# to dust") -> rock_shatter.

[rock_rip]
display_name = Sunder the Earth
emitter = sphere
count = 128
lifetime = 0.6,1.8
speed = 6,18
spread = 120
size = 1.0,4.0
colors = 3a2e24,8a5a2a
additive = false
gravity = -4.0
texture = smoke
duration = 2.0
loop = false

