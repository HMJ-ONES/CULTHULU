# CULT-ULHU ability visual-effect library (wave 36).
#
# Event-driven presets: fxForEvent() maps non-spell game events onto this
# same catalog so the engine plays real visuals through the same particle
# pipeline. Destruction events (CityBuildingDestroyed / DistrictRazed /
# CityDestroyed / TowerDestroyed / GreatOldOneSlain) resolve to `raze`;
# streak and sudden-death punctuation (KillStreak / OvertimeStarted) to
# `stun`; raw violence (FirstBlood / PlayerKilled / DholeAmbush) to
# `aoe_damage`; relic moments (RelicManifested / RelicClaimed) to
# `summon`; MaddeningWhispers to `fear_aura`; triumphs and returns
# (PointCaptured / AchievementUnlocked / MatchPoint / PlayerRespawned /
# DiscoveryMade / DungeonCompleted) to `buff`. No new presets were added
# for events — all within the low-spec particle budget. A spell with no
# explicit `fx` line in character.def automatically uses the preset whose
# id matches its effect kind, so all 60 Q/F/R abilities across the 20
# kits get visuals for free. Character authors can override with
# `fx = <id>` in [q]/[f]/[r].
#
# RMB heavy attacks resolve the same way through fxForHeavyAttack():
# one preset per HeavyAttackKind (ids match the kind names), with an
# optional `fx = <id>` override in [rightclick]. The rock kit's rip /
# hurl / shatter moments are event-driven (AbilityCast, slot 3, rock
# tags) and resolve to the rock_* presets through fxForEvent().
#
# Format: [preset id], then key = value. Ranges are "min,max".
# colors are hex RRGGBB "start,end". texture is one of
# none|smoke|spark|rune|mist|ichor.
#
# Low-spec budget rules (enforced by tests_wave36):
#   count <= 256 per burst; additive presets <= 128 (fill-rate);
#   looping emitters <= 64; duration <= 4 s; size <= 6 m.

[aoe_damage]
display_name = Eldritch Impact
emitter = sphere
count = 120
lifetime = 0.4,1.2
speed = 6,18
spread = 90
size = 0.8,3.0
colors = 1a0b2e,7a2fd0
additive = false
gravity = -2.0
texture = smoke
duration = 1.6
loop = false

